# Frontend Environment Variables Template
# Copy this file to .env.local and fill in your values:

# Backend API Base URL (default ASP.NET local port is 5023)
VITE_BACKEND_URL=http://localhost:5023

# Preferred default language (en or ar)
VITE_DEFAULT_LANGUAGE=en

# Gemini API Key (optional for client-side testing)
VITE_GEMINI_API_KEY=
