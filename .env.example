# ===================================================
# ResearchHub Backend Environment Variables Template
# In Production: Set these in your hosting environment (Azure, Render, Railway, etc.)
# In Local: Copy to .env or set in launchSettings.json / User Secrets
# ===================================================

# Google Gemini API
Gemini__ApiKey=YOUR_GEMINI_API_KEY_HERE
Gemini__Model=gemini-1.5-flash

# OpenAlex Academic Research API
OpenAlex__ApiKey=YOUR_OPENALEX_API_KEY_HERE

# ASP.NET Core Settings
ASPNETCORE_ENVIRONMENT=Development
